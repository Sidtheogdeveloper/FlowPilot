POSTGRES_PASSWORD=replace_with_a_local_password
HF_INFERENCE_URL=http://llm:8001/v1/chat/completions

# Separate general-table model; enabled with --profile table-llm after passing evaluation.
TABLE_INFERENCE_URL=http://table_llm:8002/v1/chat/completions
TABLE_ADAPTER_PATH=/adapters/table-lora

# Accounts and deployment (development permits local HTTP cookies only)
APP_ENV=development
APP_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:18080,http://127.0.0.1:18080,http://localhost:5173
ALLOW_REGISTRATION=true
# Email verification/recovery: required for APP_ENV=production
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
